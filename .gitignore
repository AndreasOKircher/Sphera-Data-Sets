# --- Python ---
**/__pycache__/
**/.pytest_cache/
*.pyc

# --- Virtual environment ---
.venv/

# --- Dataset files ---
# Output: entire directory excluded (downloaded XML/JSON, fail reports)
dataset/output/
# Enriched: sidecar JSON files from Module 4 LLM enrichment
dataset/enriched/
# Input: exclude everything except .txt URL lists
dataset/input/*
!dataset/input/*.txt

# --- Secrets ---
.env
cookie.txt
cookie*.txt

# --- IDE / tooling ---
.vscode/
.claude/
.superpowers/

# --- Git worktrees ---
.worktrees/

# --- Build artifacts ---
dist/
build/sphera-*/
*.spec
*.exe

# --- Runtime data ---
dataset/Web/
dataset/dedup/

# --- Scratch / source material ---
tmp/
ressources/
test_urls.txt
